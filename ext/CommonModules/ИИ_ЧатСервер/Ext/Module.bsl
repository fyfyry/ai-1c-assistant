КонецФункции

// Сохраняет файлы зарегистрированных в базе дополнительных отчётов и обработок
// в каталог обмена epf, чтобы мост разобрал их в XML для ИИ-помощника.
// В конфигурациях без БСП справочника нет — тогда каталог просто остаётся пустым.
Процедура ВыгрузитьДополнительныеОтчетыИОбработки()

	// Каталог пересоздаём, чтобы удалённые из базы обработки исчезли и из выгрузки.
	КаталогФайлов = КаталогОбмена() + "\epf";
	ФайлКаталога = Новый Файл(КаталогФайлов);
	Если ФайлКаталога.Существует() Тогда
		УдалитьФайлы(КаталогФайлов);
	КонецЕсли;
	СоздатьКаталог(КаталогФайлов);

	МетаданныеСправочника = Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки");
	Если МетаданныеСправочника = Неопределено
		Или МетаданныеСправочника.Реквизиты.Найти("ХранилищеОбработки") = Неопределено
		Или Метаданные.Перечисления.Найти("ВидыДополнительныхОтчетовИОбработок") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Текст запроса собирается во время выполнения, поэтому модуль компилируется и без БСП.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обработки.Наименование КАК Наименование,
	|	Обработки.ИмяОбъекта КАК ИмяОбъекта,
	|	Обработки.ХранилищеОбработки КАК ХранилищеОбработки,
	|	ВЫБОР
	|		КОГДА Обработки.Вид В (ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.Отчет),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоОтчет
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	НЕ Обработки.ПометкаУдаления";
	Если МетаданныеСправочника.Иерархический Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ Обработки.ЭтоГруппа";
	КонецЕсли;

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Структура справочника в этой конфигурации отличается от БСП — обработки не выгружаем.
		Возврат;
	КонецПопытки;

	ИспользованныеИмена = Новый Соответствие;
	Пока Выборка.Следующий() Цикл

		ДвоичныеДанные = Выборка.ХранилищеОбработки.Получить();
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;

		ИмяФайла = ?(ЗначениеЗаполнено(Выборка.ИмяОбъекта), Выборка.ИмяОбъекта, Выборка.Наименование);
		ИмяФайла = ДопустимоеИмяФайла(ИмяФайла);
		Если ИспользованныеИмена[ВРег(ИмяФайла)] <> Неопределено Тогда
			ИмяФайла = ИмяФайла + "_" + Формат(ИспользованныеИмена.Количество(), "ЧГ=0");
		КонецЕсли;
		ИспользованныеИмена.Вставить(ВРег(ИмяФайла), Истина);

		ДвоичныеДанные.Записать(КаталогФайлов + "\" + ИмяФайла + ?(Выборка.ЭтоОтчет, ".erf", ".epf"));

	КонецЦикла;

КонецПроцедуры

Функция ДопустимоеИмяФайла(Знач Имя)

	Для Каждого Символ Из СтрРазделить("\,/,:,*,?,"",<,>,|", ",") Цикл
		Имя = СтрЗаменить(Имя, Символ, "_");
	КонецЦикла;
	Имя = СокрЛП(Имя);

	Возврат ?(ПустаяСтрока(Имя), "Обработка", Имя);

КонецФункции

Процедура ЗаписатьСообщение(Идентификатор, Чат, Автор, Текст, ОтветНа)

	МенеджерЗаписи = РегистрыСведений.ИИ_СообщенияЧата.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Чат = Чат;
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	МенеджерЗаписи.Порядок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МенеджерЗаписи.Автор = Автор;
	МенеджерЗаписи.Текст = Текст;
	МенеджерЗаписи.ОтветНа = ОтветНа;
	МенеджерЗаписи.Записать();

КонецПроцедуры

Процедура УдалитьЗаписьСообщения(Идентификатор)

	НаборЗаписей = РегистрыСведений.ИИ_СообщенияЧата.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Записать();

КонецПроцедуры

Процедура ЗаписатьЗапрос(Идентификатор, Данные)

	КаталогВходящих = КаталогОбмена() + "\in\";
	// Имя начинается со времени, чтобы мост обрабатывал запросы по порядку.
	ИмяФайла = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + "_" + Идентификатор;

	// Пишем во временный файл и переименовываем, чтобы мост не прочитал файл недописанным.
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(КаталогВходящих + ИмяФайла + ".tmp", "UTF-8", Ложь);
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписьJSON.Закрыть();

	ПереместитьФайл(КаталогВходящих + ИмяФайла + ".tmp", КаталогВходящих + ИмяФайла + ".json");

КонецПроцедуры

Функция ПрочитатьФайлJSON(ПолноеИмя)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(ПолноеИмя, "UTF-8");
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("id") Или Не Данные.Свойство("type") Или Не Данные.Свойство("text") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция МостАктивен(Каталог)

	Метка = Новый Файл(Каталог + "\bridge.alive");
	Если Не Метка.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТекущаяУниверсальнаяДата() - Метка.ПолучитьУниверсальноеВремяИзменения() < 10;

КонецФункции

// Каталог обмена создаётся при первом обращении. Мост вычисляет его по тем же правилам:
//   файловая база — <каталог базы>\ai-chat,
//   клиент-серверная — C:\ProgramData\1C-AI\<сервер>_<имя базы> в нижнем регистре
//   (сервер 1С должен работать на том же компьютере, что и мост).
Функция КаталогОбмена()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	КаталогБазы = ПараметрСтрокиСоединения(СтрокаСоединения, "File");
	Если ЗначениеЗаполнено(КаталогБазы) Тогда
		Каталог = КаталогБазы + "\ai-chat";
	Иначе
		Ключ = НРег(ПараметрСтрокиСоединения(СтрокаСоединения, "Srvr") + "_"
			+ ПараметрСтрокиСоединения(СтрокаСоединения, "Ref"));
		Каталог = "C:\ProgramData\1C-AI\" + ДопустимоеИмяФайла(Ключ);
	КонецЕсли;

	Для Каждого Подкаталог Из СтрРазделить("in,out", ",") Цикл
		ФайлКаталога = Новый Файл(Каталог + "\" + Подкаталог);
		Если Не ФайлКаталога.Существует() Тогда
			СоздатьКаталог(Каталог + "\" + Подкаталог);
		КонецЕсли;
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Возвращает значение параметра строки соединения вида Имя="Значение"; или пустую строку.
Функция ПараметрСтрокиСоединения(СтрокаСоединения, Имя)

	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 И ВРег(СокрЛП(Лев(Часть, Позиция - 1))) = ВРег(Имя) Тогда
			Возврат СтрЗаменить(СокрЛП(Сред(Часть, Позиция + 1)), """", "");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Начало текста в одну строку, не длиннее Длина символов.
Функция Фрагмент(Знач Текст, Длина)

	Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " "), Символы.ВК, ""));
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Если СтрДлина(Текст) > Длина Тогда
		Текст = СокрП(Лев(Текст, Длина - 1)) + "…";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ЭкранироватьHTML(Знач Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Возврат СтрЗаменить(Текст, ">", "&gt;");

КонецФункции

// Экранирует текст для HTML, блоки кода в ``` выводит моноширинным шрифтом.
Функция ТекстВHTML(Знач Текст)

	Текст = ЭкранироватьHTML(Текст);

	Фрагменты = РазделитьПоПодстроке(Текст, "```");
	Если Фрагменты.Количество() < 3 Тогда
		Возврат СокрЛП(Текст);
	КонецЕсли;

	Части = Новый Массив;
	Для Индекс = 0 По Фрагменты.ВГраница() Цикл
		Часть = Фрагменты[Индекс];
		Если Индекс % 2 = 0 Тогда
			Части.Добавить(СокрЛП(Часть));
		Иначе
			// Первая строка блока кода — язык (bsl, 1c и т.п.), её не показываем.
			ПереводСтроки = СтрНайти(Часть, Символы.ПС);
			Если ПереводСтроки > 0 Тогда
				Часть = Сред(Часть, ПереводСтроки + 1);
			КонецЕсли;
			Части.Добавить("<pre>" + СокрП(Часть) + "</pre>");
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// СтрРазделить делит по каждому символу разделителя, а здесь разделитель — подстрока целиком.
Функция РазделитьПоПодстроке(Знач Текст, Разделитель)

	Части = Новый Массив;
	Позиция = СтрНайти(Текст, Разделитель);
	Пока Позиция > 0 Цикл
		Части.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
		Позиция = СтрНайти(Текст, Разделитель);
	КонецЦикла;
	Части.Добавить(Текст);
	Возврат Части;

КонецФункции

#КонецОбласти
