// Сообщения, записанные до появления чатов, переносит в отдельный чат текущего пользователя.
Процедура ПеренестиСообщенияБезЧата()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Идентификатор КАК Идентификатор,
	|	Сообщения.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ИИ_СообщенияЧата КАК Сообщения
	|ГДЕ
	|	Сообщения.Чат = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.Порядок";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Чат = Строка(Новый УникальныйИдентификатор);
	Создан = Неопределено;
	Изменен = Неопределено;
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ИИ_СообщенияЧата.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Чат = Чат;
		МенеджерЗаписи.Записать();
		Если Создан = Неопределено Тогда
			Создан = Выборка.Дата;
		КонецЕсли;
		Изменен = Выборка.Дата;
	КонецЦикла;

	МенеджерЗаписи = РегистрыСведений.ИИ_Чаты.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Чат;
	МенеджерЗаписи.Пользователь = ИдентификаторПользователя();
	МенеджерЗаписи.Наименование = НСтр("ru = 'Переписка до появления чатов'");
	МенеджерЗаписи.Создан = Создан;
	МенеджерЗаписи.Изменен = Изменен;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Чат текущего пользователя или Неопределено.
Функция ДанныеЧата(Чат)

	Если Не ЗначениеЗаполнено(Чат) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ИИ_Чаты.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Чат;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Или МенеджерЗаписи.Пользователь <> ИдентификаторПользователя() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Наименование,Создан,ОжидаетОтвета",
		МенеджерЗаписи.Наименование, МенеджерЗаписи.Создан, МенеджерЗаписи.ОжидаетОтвета);

КонецФункции

