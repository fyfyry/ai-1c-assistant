
// Обмен с мостом ИИ-помощника идёт через файлы в каталоге обмена (см. КаталогОбмена):
//   in\*.json    — запросы из 1С:
//                  message    — сообщение чата: id, chat, title, started, text, replyTo (author, date, text),
//                               history — предыдущие сообщения чата (id, author, date, text),
//                               rules — правила базы, names — полные имена пользователей для обезличивания;
//                  refresh    — обновить выгрузку конфигурации;
//                  deletechat — чат удалён, мосту нужно забыть его сессию: chat;
//   out\*.json   — ответы моста: reply (id, chat, replyId, text) и refresh (id, text),
//   epf\         — файлы дополнительных отчётов и обработок, зарегистрированных в базе,
//   bridge.alive — метка «мост запущен», мост обновляет её каждую секунду.
//
// Чаты (регистр ИИ_Чаты) у каждого пользователя свои. Сообщения (ИИ_СообщенияЧата) ссылаются на чат
// и, если это ответ, на сообщение, на которое отвечают. Правила базы (ИИ_ПравилаБазы) общие для всех чатов.

#Область ПрограммныйИнтерфейс

// Причина, по которой чат не может обмениваться файлами с мостом, или пустая строка.
// Расширение, загруженное через конфигуратор, в некоторых базах включается в безопасном режиме,
// а в нём работа с файлами запрещена.
//
// Возвращаемое значение:
//   Строка
//
Функция ПроблемаЗапуска() Экспорт

	ФайлыДоступны = Истина;
	Попытка
		Каталог = Новый Файл(КаталогВременныхФайлов());
		Каталог.Существует();
	Исключение
		ФайлыДоступны = Ложь;
	КонецПопытки;

	Если БезопасныйРежим() <> Ложь Или Не ФайлыДоступны Тогда
		Возврат НСтр("ru = 'Расширение ИИПомощник работает в безопасном режиме и не может связаться с мостом. Откройте «Администрирование — Печатные формы, отчеты и обработки — Расширения» (или «Все функции — Стандартные — Управление расширениями конфигурации»), снимите у расширения ИИПомощник флажок «Безопасный режим» и перезапустите 1С.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Чаты текущего пользователя, недавние сверху.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Идентификатор, Наименование, Изменен, ОжидаетОтвета.
//
Функция ЧатыПользователя() Экспорт

	ПеренестиСообщенияБезЧата();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Чаты.Идентификатор КАК Идентификатор,
	|	Чаты.Наименование КАК Наименование,
	|	Чаты.Изменен КАК Изменен,
	|	Чаты.ОжидаетОтвета КАК ОжидаетОтвета
	|ИЗ
	|	РегистрСведений.ИИ_Чаты КАК Чаты
	|ГДЕ
	|	Чаты.Пользователь = &Пользователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	Изменен УБЫВ";
	Запрос.УстановитьПараметр("Пользователь", ИдентификаторПользователя());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Записывает сообщение пользователя в чат и передаёт его мосту вместе с перепиской чата и правилами базы.
//
// Параметры:
//   Чат - Строка - идентификатор чата; пустой — начать новый чат.
//   Текст - Строка
//   ОтветНа - Строка - идентификатор сообщения, на которое отвечает пользователь.
//
// Возвращаемое значение:
//   Строка - идентификатор чата, в который записано сообщение.
//
Функция ОтправитьСообщение(Знач Чат, Знач Текст, Знач ОтветНа = "") Экспорт

	Текст = СокрЛП(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Чат;
	КонецЕсли;

	ДанныеЧата = ДанныеЧата(Чат);
	Если ДанныеЧата = Неопределено Тогда
		Чат = Строка(Новый УникальныйИдентификатор);
		ДанныеЧата = СоздатьЧат(Чат, НаименованиеЧата(Текст));
	КонецЕсли;

	История = Новый Массив;
	Цитата = Неопределено;
	Выборка = ВыборкаСообщений(Чат);
	Пока Выборка.Следующий() Цикл
		Описание = ОписаниеДляМоста(Выборка);
		История.Добавить(Описание);
		Если ЗначениеЗаполнено(ОтветНа) И Выборка.Идентификатор = ОтветНа Тогда
			Цитата = Описание;
		КонецЕсли;
	КонецЦикла;
	Если Цитата = Неопределено Тогда
		ОтветНа = "";
	КонецЕсли;

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ЗаписатьСообщение(Идентификатор, Чат, "Пользователь", Текст, ОтветНа);
	ОбновитьЧат(Чат, Истина);

	Данные = Новый Структура;
	Данные.Вставить("id", Идентификатор);
	Данные.Вставить("type", "message");
	Данные.Вставить("chat", Чат);
	Данные.Вставить("title", ДанныеЧата.Наименование);
	Данные.Вставить("started", Формат(ДанныеЧата.Создан, "ДФ='dd.MM.yyyy HH:mm'"));
	Данные.Вставить("text", Текст);
	Данные.Вставить("replyTo", Цитата);
	Данные.Вставить("history", История);
	Данные.Вставить("rules", ДействующиеПравила());
	Данные.Вставить("names", ИменаПользователей());
	ЗаписатьЗапрос(Идентификатор, Данные);

	Возврат Чат;

КонецФункции

// Удаляет сообщение из чата текущего пользователя. При следующем сообщении мост начнёт
// новую сессию Claude с оставшейся перепиской, так что удалённое Claude больше не увидит.
//
// Параметры:
//   Идентификатор - Строка
//
Процедура УдалитьСообщение(Знач Идентификатор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИИ_СообщенияЧата КАК Сообщения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИИ_Чаты КАК Чаты
	|		ПО Сообщения.Чат = Чаты.Идентификатор
	|ГДЕ
	|	Сообщения.Идентификатор = &Идентификатор
	|	И Чаты.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Пользователь", ИдентификаторПользователя());
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	УдалитьЗаписьСообщения(Идентификатор);

КонецПроцедуры

// Удаляет чат текущего пользователя со всеми сообщениями и просит мост удалить сессию Claude.
//
// Параметры:
//   Чат - Строка
//
Процедура УдалитьЧат(Знач Чат) Экспорт

	Если ДанныеЧата(Чат) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выборка = ВыборкаСообщений(Чат);
	Пока Выборка.Следующий() Цикл
		УдалитьЗаписьСообщения(Выборка.Идентификатор);
	КонецЦикла;

	НаборЗаписей = РегистрыСведений.ИИ_Чаты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(Чат);
	НаборЗаписей.Записать();

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ЗаписатьЗапрос(Идентификатор, Новый Структура("id,type,chat,text", Идентификатор, "deletechat", Чат, ""));

КонецПроцедуры

// Короткое описание сообщения для панели «Ответ на сообщение» над полем ввода.
//
// Параметры:
//   Идентификатор - Строка
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеСообщения(Знач Идентификатор) Экспорт

	МенеджерЗаписи = РегистрыСведений.ИИ_СообщенияЧата.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("%1, %2: %3",
		?(МенеджерЗаписи.Автор = "ИИ", НСтр("ru = 'ИИ-помощник'"), НСтр("ru = 'Вы'")),
		Формат(МенеджерЗаписи.Дата, "ДФ='dd.MM HH:mm'"),
		Фрагмент(МенеджерЗаписи.Текст, 120));

КонецФункции

// Просит мост обновить выгрузку конфигурации.
//
// Возвращаемое значение:
//   Строка - идентификатор запроса, по нему форма узнаёт о завершении обновления.
//
Функция ЗапроситьОбновление() Экспорт

	Если ЗначениеЗаполнено(ПроблемаЗапуска()) Тогда
		Возврат "";
	КонецЕсли;

	ВыгрузитьДополнительныеОтчетыИОбработки();

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Данные = Новый Структура("id,type,text", Идентификатор, "refresh", "");
	// Кто менял конфигурацию, расширения и обработки с прошлого обновления — мост добавит это в журнал изменений.
	Данные.Вставить("events", СобытияИзменений());
	// Хранилище передаём, только если его хоть раз настраивали в 1С: иначе мост оставит
	// настройку из мастера установки (bases.json) как есть.
	Настройки = НастройкиХранилища();
	Если Настройки <> Неопределено Тогда
		Данные.Вставить("repository", Новый Структура("path,user,password,depth",
			Настройки.Путь, Настройки.Пользователь, Настройки.Пароль, Настройки.Глубина));
	КонецЕсли;
	ЗаписатьЗапрос(Идентификатор, Данные);
	Возврат Идентификатор;

КонецФункции

// Хранилище конфигурации, из которого мост берёт историю изменений.
//
// Возвращаемое значение:
//   Структура - Путь, Пользователь, Пароль, Глубина; пустой Путь — хранилище не используется.
//   Неопределено - хранилище в 1С не настраивали.
//
Функция НастройкиХранилища() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Имя КАК Имя,
	|	Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ИИ_Настройки КАК Настройки
	|ГДЕ
	|	Настройки.Имя ПОДОБНО ""Хранилище%""";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Настройки = Новый Структура("Путь,Пользователь,Пароль,Глубина", "", "", "", 20);
	Пока Выборка.Следующий() Цикл
		Ключ = Сред(Выборка.Имя, СтрДлина("Хранилище") + 1);
		Если Ключ = "Глубина" Тогда
			Настройки.Глубина = Число(Выборка.Значение);
		ИначеЕсли Настройки.Свойство(Ключ) Тогда
			Настройки[Ключ] = Выборка.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

// Записывает хранилище конфигурации; мост применит его при следующем обновлении.
//
// Параметры:
//   Настройки - Структура - Путь, Пользователь, Пароль, Глубина.
//
Процедура ЗаписатьНастройкиХранилища(Знач Настройки) Экспорт

	Для Каждого Элемент Из Настройки Цикл
		МенеджерЗаписи = РегистрыСведений.ИИ_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Имя = "Хранилище" + Элемент.Ключ;
		МенеджерЗаписи.Значение = Формат(Элемент.Значение, "ЧГ=0");
		МенеджерЗаписи.Записать();
	КонецЦикла;

КонецПроцедуры

// Забирает ответы моста и сообщает состояние обмена.
//
// Параметры:
//   Чат - Строка - открытый в форме чат.
//   ИдентификаторОбновления - Строка - запрос обновления, завершения которого ждёт форма.
//
// Возвращаемое значение:
//   Структура:
//     * ЕстьНовые - Булево - в открытый чат добавлены ответы, История заполнена.
//     * История - Строка - HTML открытого чата.
//     * ИзменилисьЧаты - Булево - пришли ответы в какие-то чаты, список чатов надо перечитать.
//     * ОбновлениеЗавершено - Булево
//     * ТекстОбновления - Строка - результат обновления выгрузки.
//     * МостАктивен - Булево
//     * ОжидаетсяОтвет - Булево - мост ещё не ответил в открытом чате.
//
Функция ПроверитьОтветы(Знач Чат, Знач ИдентификаторОбновления = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЕстьНовые", Ложь);
	Результат.Вставить("История", "");
	Результат.Вставить("ИзменилисьЧаты", Ложь);
	Результат.Вставить("ОбновлениеЗавершено", Ложь);
	Результат.Вставить("ТекстОбновления", "");

	Каталог = КаталогОбмена();

	Файлы = НайтиФайлы(Каталог + "\out", "*.json");
	Для Каждого Файл Из Файлы Цикл

		Ответ = ПрочитатьФайлJSON(Файл.ПолноеИмя);
		Если Ответ = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Ответ.type = "reply" Тогда
			ЧатОтвета = "";
			Ответ.Свойство("chat", ЧатОтвета);
			Если ЗначениеЗаполнено(ЧатОтвета) И ЧатСуществует(ЧатОтвета) Тогда
				ИдентификаторОтвета = "";
				Ответ.Свойство("replyId", ИдентификаторОтвета);
				Если Не ЗначениеЗаполнено(ИдентификаторОтвета) Тогда
					ИдентификаторОтвета = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
				ЗаписатьСообщение(ИдентификаторОтвета, ЧатОтвета, "ИИ", Ответ.text, "");
				ОбновитьЧат(ЧатОтвета, Ложь);
				Результат.ИзменилисьЧаты = Истина;
				Если ЧатОтвета = Чат Тогда
					Результат.ЕстьНовые = Истина;
				КонецЕсли;
			КонецЕсли;
			// Ответы в удалённые чаты просто удаляются.
		ИначеЕсли Ответ.type = "refresh" Тогда
			// Журнал изменений записываем из любого ответа на обновление, даже если форма, которая его
			// запросила, уже закрыта.
			Изменения = Неопределено;
			Если Ответ.Свойство("changes", Изменения) Тогда
				ЗаписатьИзменения(Изменения);
			КонецЕсли;
			// Чей бы ни был ответ, запоминаем его: форма «История изменений» узнает о завершении проверки,
			// даже если ответ первой забрала форма чата.
			ЗаписатьНастройку("Обновление.Последнее", Ответ.id + "|" + Ответ.text);
			Если Ответ.id = ИдентификаторОбновления Тогда
				Результат.ОбновлениеЗавершено = Истина;
				Результат.ТекстОбновления = Ответ.text;
			КонецЕсли;
		КонецЕсли;
		// Ответы на устаревшие запросы обновления тоже просто удаляются.

		УдалитьФайлы(Файл.ПолноеИмя);

	КонецЦикла;

	Если Результат.ЕстьНовые Тогда
		Результат.История = ИсторияHTML(Чат);
	КонецЕсли;

	ДанныеЧата = ДанныеЧата(Чат);
	Результат.Вставить("МостАктивен", МостАктивен(Каталог));
	Результат.Вставить("ОжидаетсяОтвет", ДанныеЧата <> Неопределено И ДанныеЧата.ОжидаетОтвета);

	Возврат Результат;

КонецФункции

// Формирует HTML переписки чата. Ссылки в сообщениях обрабатывает форма чата:
//   #reply:<идентификатор>  — ответить на сообщение,
//   #delete:<идентификатор> — удалить сообщение,
//   #m<идентификатор>       — перейти к сообщению, на которое отвечали.
//
// Параметры:
//   Чат - Строка - пустой — новый чат.
//
// Возвращаемое значение:
//   Строка
//
Функция ИсторияHTML(Знач Чат) Экспорт

	Части = Новый Массив;
	Части.Добавить(
	"<!DOCTYPE html><html><head><meta charset=""utf-8""><meta http-equiv=""X-UA-Compatible"" content=""IE=edge""><style>
	|body{font-family:Arial,sans-serif;font-size:10pt;background:#f4f5f7;margin:0;padding:10px}
	|.m{max-width:80%;padding:8px 12px;border-radius:10px;margin:6px 0;white-space:pre-wrap;word-wrap:break-word;clear:both}
	|.u{float:right;background:#d9ecff}
	|.a{float:left;background:#fff;border:1px solid #e1e4e8}
	|.t{font-size:8pt;color:#888;margin-bottom:3px;white-space:normal}
	|.act{visibility:hidden;margin-left:10px}
	|.m:hover .act{visibility:visible}
	|.act a{color:#5b7fb0;text-decoration:none;margin-left:8px}
	|.act a:hover{text-decoration:underline}
	|.q{display:block;border-left:3px solid #8ab4f8;padding:3px 8px;margin:2px 0 6px;color:#555;background:rgba(0,0,0,.04);text-decoration:none;white-space:normal;font-size:9pt}
	|pre{background:#f0f0f0;padding:6px;margin:4px 0;white-space:pre-wrap;font-family:Consolas,monospace;font-size:9pt}
	|.e{color:#888;text-align:center;margin-top:40px}
	|.end{clear:both}
	|</style></head><body>");

	Выборка = ВыборкаСообщений(Чат);
	Если Выборка.Количество() = 0 Тогда
		Части.Добавить("<div class=""e"">" + НСтр("ru = 'Новый чат. Напишите сообщение ИИ-помощнику.'") + "</div>");
	КонецЕсли;

	Пока Выборка.Следующий() Цикл

		ЭтоПользователь = (Выборка.Автор <> "ИИ");
		Цитата = "";
		Если ЗначениеЗаполнено(Выборка.ОтветНа) Тогда
			Если Выборка.ЦитатаНайдена Тогда
				Цитата = СтрШаблон("<a class=""q"" href=""#m%1""><b>%2:</b> %3</a>",
					Выборка.ОтветНа,
					?(Выборка.ЦитатаАвтор = "ИИ", НСтр("ru = 'ИИ-помощник'"), НСтр("ru = 'Вы'")),
					ЭкранироватьHTML(Фрагмент(Выборка.ЦитатаТекст, 200)));
			Иначе
				Цитата = "<div class=""q"">" + НСтр("ru = 'Сообщение удалено'") + "</div>";
			КонецЕсли;
		КонецЕсли;

		Части.Добавить(СтрШаблон(
			"<div class=""m %1"" id=""m%2""><div class=""t"">%3, %4<span class=""act""><a href=""#reply:%2"">%5</a><a href=""#delete:%2"">%6</a></span></div>%7%8</div>",
			?(ЭтоПользователь, "u", "a"),
			Выборка.Идентификатор,
			?(ЭтоПользователь, НСтр("ru = 'Вы'"), НСтр("ru = 'ИИ-помощник'")),
			Формат(Выборка.Дата, "ДФ='dd.MM.yyyy HH:mm'"),
			НСтр("ru = 'Ответить'"),
			НСтр("ru = 'Удалить'"),
			Цитата,
			ТекстВHTML(Выборка.Текст)));

	КонецЦикла;

	// Прокрутка к последнему сообщению: сразу, после загрузки и с задержкой — поле HTML
	// может выставить прокрутку уже после разбора документа. Ещё раз прокручивает форма (ДокументСформирован).
	Части.Добавить("<div class=""end"" id=""end""></div><script>
	|function toEnd(){var e=document.getElementById('end');if(e&&e.scrollIntoView){e.scrollIntoView(false);}else{window.scrollTo(0,document.body.scrollHeight);}}
	|toEnd();window.onload=function(){toEnd();setTimeout(toEnd,100);};setTimeout(toEnd,300);
	|</script></body></html>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Правила базы, которые учитываются во всех чатах.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Используется, Текст.
//
Функция ПравилаБазы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Используется КАК Используется,
	|	Правила.Текст КАК Текст
	|ИЗ
	|	РегистрСведений.ИИ_ПравилаБазы КАК Правила
	|
	|УПОРЯДОЧИТЬ ПО
	|	Правила.Порядок";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Заменяет правила базы.
//
// Параметры:
//   Правила - Массив из Структура - Используется, Текст.
//
Процедура ЗаписатьПравилаБазы(Знач Правила) Экспорт

	НаборЗаписей = РегистрыСведений.ИИ_ПравилаБазы.СоздатьНаборЗаписей();
	Порядок = 0;
	Для Каждого Правило Из Правила Цикл
		Если ПустаяСтрока(Правило.Текст) Тогда
			Продолжить;
		КонецЕсли;
		Порядок = Порядок + 1;
		Запись = НаборЗаписей.Добавить();
		Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
		Запись.Порядок = Порядок;
		Запись.Текст = СокрЛП(Правило.Текст);
		Запись.Используется = Правило.Используется;
	КонецЦикла;
	НаборЗаписей.Записать();

КонецПроцедуры

// Справка по работе с ИИ-помощником (кнопка «Справка» в окне чата).
//
// Возвращаемое значение:
//   Строка - HTML.
//
Функция СправкаHTML() Экспорт

	Возврат
	"<!DOCTYPE html><html><head><meta charset=""utf-8""><meta http-equiv=""X-UA-Compatible"" content=""IE=edge""><style>
	|body{font-family:Arial,sans-serif;font-size:10pt;margin:0;padding:10px 14px;color:#000}
	|h1{font-size:12pt;margin:0 0 10px}
	|h2{font-size:10pt;margin:14px 0 4px}
	|p{margin:4px 0}
	|ul{margin:4px 0;padding-left:18px}
	|li{margin:2px 0}
	|</style></head><body>
	|<h1>ИИ-помощник</h1>
	|<p>Помощник отвечает на вопросы по этой информационной базе: по конфигурации, программному коду, расширениям, внешним обработкам и отчетам. При открытии окна конфигурация перечитывается, поэтому учитываются последние сохраненные изменения. На вопросы, не связанные с 1С, помощник не отвечает.</p>
	|
	|<h2>Вопросы</h2>
	|<p>Введите вопрос в поле внизу окна и нажмите кнопку «Отправить» или сочетание клавиш Ctrl+Enter. Ответ обычно приходит в течение минуты. Если известно, о каком объекте идет речь, укажите его в вопросе. Примеры:</p>
	|<ul>
	|<li>Где в программе рассчитывается НДФЛ при начислении зарплаты?</li>
	|<li>Какие типовые объекты изменяет расширение …?</li>
	|<li>Составь запрос остатков по счету 201.11 в разрезе учреждений.</li>
	|</ul>
	|
	|<h2>Чаты</h2>
	|<p>Слева выводится список чатов, сгруппированный по дням. Чтобы продолжить разговор, выберите чат в списке. Чтобы начать разговор на новую тему, нажмите «Новый чат». Каждый чат учитывает только свою переписку.</p>
	|<p>При наведении указателя на сообщение появляются команды «Ответить» (ответ на это сообщение) и «Удалить» (удаленное сообщение помощник больше не учитывает). Чат целиком удаляется кнопкой «Удалить чат» или из контекстного меню списка.</p>
	|
	|<h2>Правила базы</h2>
	|<p>По кнопке «Правила базы» задаются ограничения и пожелания, которые помощник соблюдает во всех чатах всех пользователей, например «Логику проведения в расширении … не изменять». Действуют правила, у которых установлен флажок «Действует». После изменения нажмите «Записать и закрыть».</p>
	|
	|<h2>История изменений</h2>
	|<p>По кнопке «История изменений» открывается список изменений конфигурации, расширений, внешних обработок и отчетов: что изменено, кем и когда (по журналу регистрации), а также сами изменения кода. Добавленные строки выделены зеленым, удаленные — красным. Вопрос об изменениях можно задать и в чате.</p>
	|
	|<h2>Создание обработок, отчетов и расширений</h2>
	|<p>Помощнику можно поручить создать или доработать внешнюю обработку, внешний отчет или расширение конфигурации. Код проверяется на ошибки, а в конце ответа указывается путь к готовому файлу (.epf, .erf или .cfe) в папке «Готовые файлы» на компьютере, где работает мост.</p>
	|<p>Обработки и отчеты подключаются в разделе «Администрирование — Печатные формы, отчеты и обработки — Дополнительные отчеты и обработки», расширения — в разделе «Расширения». Основную конфигурацию помощник не изменяет. Перед использованием рекомендуется проверить файл на копии базы.</p>
	|
	|<h2>Персональные данные</h2>
	|<p>Фамилии, телефоны, адреса электронной почты, ИНН, СНИЛС, паспортные данные, номера карт и счетов перед отправкой заменяются условными обозначениями и подставляются обратно в ответ. Программный код конфигурации передается без изменений.</p>
	|
	|<h2>Возможные затруднения</h2>
	|<ul>
	|<li>«Мост не запущен» — на компьютере, где установлен помощник, запустите файл ai-bridge.cmd из папки помощника. Отправленные сообщения будут обработаны после запуска.</li>
	|<li>«Обновляю выгрузку конфигурации» — дождитесь окончания обновления; для больших конфигураций оно занимает больше времени.</li>
	|<li>Сообщение о безопасном режиме — в списке расширений снимите у расширения помощника флажок «Безопасный режим» и перезапустите программу.</li>
	|</ul>
	|</body></html>";

КонецФункции

// Состояние запроса обновления для формы «История изменений»: забирает ответы моста и сообщает,
// закончена ли проверка (ответ мог забрать и чат — тогда смотрим запомненный ответ).
//
// Параметры:
//   Идентификатор - Строка - результат ЗапроситьОбновление().
//
// Возвращаемое значение:
//   Структура - Завершено, Текст, МостАктивен.
//
Функция СостояниеОбновления(Знач Идентификатор) Экспорт

	Результат = ПроверитьОтветы("", Идентификатор);
	Состояние = Новый Структура("Завершено,Текст,МостАктивен",
		Результат.ОбновлениеЗавершено, Результат.ТекстОбновления, Результат.МостАктивен);
	Если Не Состояние.Завершено Тогда
		МенеджерЗаписи = РегистрыСведений.ИИ_Настройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Имя = "Обновление.Последнее";
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() И СтрНачинаетсяС(МенеджерЗаписи.Значение, Идентификатор + "|") Тогда
			Состояние.Завершено = Истина;
			Состояние.Текст = Сред(МенеджерЗаписи.Значение, СтрДлина(Идентификатор) + 2);
		КонецЕсли;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

// Журнал изменений базы, новые сверху.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Идентификатор, Дата, Раздел, Авторы, Объекты.
//
Функция ИсторияИзменений() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	История.Идентификатор КАК Идентификатор,
	|	История.Дата КАК Дата,
	|	История.Раздел КАК Раздел,
	|	История.Авторы КАК Авторы,
	|	История.Объекты КАК Объекты
	|ИЗ
	|	РегистрСведений.ИИ_ИсторияИзменений КАК История
	|
	|УПОРЯДОЧИТЬ ПО
	|	История.Дата УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаИстории Из Таблица Цикл
		// В списке — первые два объекта, полностью — в подробностях.
		Объекты = СтрРазделить(СтрокаИстории.Объекты, Символы.ПС, Ложь);
		СтрокаИстории.Объекты = "";
		Для Индекс = 0 По Мин(1, Объекты.ВГраница()) Цикл
			СтрокаИстории.Объекты = СтрокаИстории.Объекты + ?(Индекс = 0, "", "; ") + Объекты[Индекс];
		КонецЦикла;
		Если Объекты.Количество() > 2 Тогда
			СтрокаИстории.Объекты = СтрокаИстории.Объекты + СтрШаблон(НСтр("ru = ' и еще %1'"), Объекты.Количество() - 2);
		КонецЕсли;
		Если ПустаяСтрока(СтрокаИстории.Авторы) Тогда
			СтрокаИстории.Авторы = НСтр("ru = 'не найдено в журнале регистрации'");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// HTML одной записи журнала изменений: события журнала регистрации и «было → стало».
//
// Параметры:
//   Идентификатор - Строка
//
// Возвращаемое значение:
//   Строка
//
Функция ИзмененияHTML(Знач Идентификатор) Экспорт

	Части = Новый Массив;
	Части.Добавить(
	"<!DOCTYPE html><html><head><meta charset=""utf-8""><meta http-equiv=""X-UA-Compatible"" content=""IE=edge""><style>
	|body{font-family:Arial,sans-serif;font-size:10pt;margin:0;padding:10px}
	|h3{font-size:11pt;margin:10px 0 4px}
	|.ev{white-space:pre-wrap;color:#333}
	|pre{font-family:Consolas,monospace;font-size:9pt;margin:0}
	|.add{background:#e6ffec}
	|.del{background:#ffebe9}
	|.hunk{color:#0550ae;background:#f1f8ff}
	|.file{font-weight:bold;margin-top:8px}
	|.e{color:#888;text-align:center;margin-top:40px}
	|</style></head><body>");

	МенеджерЗаписи = РегистрыСведений.ИИ_ИсторияИзменений.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Прочитать();
	Если Не ЗначениеЗаполнено(Идентификатор) Или Не МенеджерЗаписи.Выбран() Тогда
		Части.Добавить("<div class=""e"">" + НСтр("ru = 'Изменений пока нет. Они появятся, когда кто-то изменит конфигурацию, расширения или обработки, а затем будет открыт ИИ-помощник.'") + "</div>");
	ИначеЕсли ЗначениеЗаполнено(МенеджерЗаписи.Отчет) Тогда
		// Отчёт собирает мост: код — процедурами с подсветкой изменений, метаданные — описанием.
		Возврат МенеджерЗаписи.Отчет;
	Иначе
		Части.Добавить(СтрШаблон("<h3>%1 — %2</h3>", ЭкранироватьHTML(МенеджерЗаписи.Раздел), Формат(МенеджерЗаписи.Дата, "ДФ='dd.MM.yyyy HH:mm'")));
		Части.Добавить("<h3>" + НСтр("ru = 'Кто и когда (журнал регистрации)'") + "</h3>");
		Части.Добавить("<div class=""ev"">" + ЭкранироватьHTML(?(ПустаяСтрока(МенеджерЗаписи.События),
			НСтр("ru = 'В журнале регистрации событий не найдено (например, изменён файл обработки в папке).'"), МенеджерЗаписи.События)) + "</div>");
		Если ЗначениеЗаполнено(МенеджерЗаписи.Объекты) Тогда
			Части.Добавить("<h3>" + НСтр("ru = 'Объекты'") + "</h3><div class=""ev"">" + ЭкранироватьHTML(МенеджерЗаписи.Объекты) + "</div>");
		КонецЕсли;
		Части.Добавить("<h3>" + НСтр("ru = 'Что изменилось (− было, + стало)'") + "</h3>");
		Если ПустаяСтрока(МенеджерЗаписи.Изменения) Тогда
			Части.Добавить("<div class=""ev"">" + НСтр("ru = 'Изменений в коде и метаданных не найдено.'") + "</div>");
		КонецЕсли;
		Для Каждого СтрокаИзменений Из СтрРазделить(МенеджерЗаписи.Изменения, Символы.ПС, Истина) Цикл
			Класс = "";
			Если СтрНачинаетсяС(СтрокаИзменений, "+++") Или СтрНачинаетсяС(СтрокаИзменений, "---") Или СтрНачинаетсяС(СтрокаИзменений, "###") Тогда
				Класс = "file";
			ИначеЕсли СтрНачинаетсяС(СтрокаИзменений, "@@") Тогда
				Класс = "hunk";
			ИначеЕсли СтрНачинаетсяС(СтрокаИзменений, "+") Тогда
				Класс = "add";
			ИначеЕсли СтрНачинаетсяС(СтрокаИзменений, "-") Тогда
				Класс = "del";
			КонецЕсли;
			Части.Добавить(СтрШаблон("<pre class=""%1"">%2</pre>", Класс, ?(ПустаяСтрока(СтрокаИзменений), " ", ЭкранироватьHTML(СтрокаИзменений))));
		КонецЦикла;
	КонецЕсли;

	Части.Добавить("</body></html>");
	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// События журнала регистрации об изменении конфигурации, расширений и зарегистрированных
// дополнительных отчётов и обработок с прошлого обновления. Время прошлого обновления — в ИИ_Настройки.
Функция СобытияИзменений()

	Результат = Новый Массив;
	ИмяНастройки = "ЖурналИзменений.Дата";
	Конец = ТекущаяДатаСеанса();
	Начало = Неопределено;
	МенеджерЗаписи = РегистрыСведений.ИИ_Настройки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Имя = ИмяНастройки;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Попытка
			Начало = XMLЗначение(Тип("Дата"), МенеджерЗаписи.Значение);
		Исключение
			Начало = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Начало = Неопределено Тогда
		Начало = Конец - 30 * 86400;
	КонецЕсли;

	Отборы = Новый Массив;
	СобытияМетаданных = Новый Массив;
	Для Каждого Имя Из СтрРазделить("ConfigUpdate,DBConfigUpdate,ConfigExtensionUpdate,DBConfigExtensionUpdate", ",") Цикл
		СобытияМетаданных.Добавить("_$InfoBase$_." + Имя);
	КонецЦикла;
	Отборы.Добавить(Новый Структура("ДатаНачала,ДатаОкончания,Событие", Начало, Конец, СобытияМетаданных));
	Справочник = Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки");
	Если Справочник <> Неопределено Тогда
		СобытияДанных = Новый Массив;
		Для Каждого Имя Из СтрРазделить("New,Update,Delete", ",") Цикл
			СобытияДанных.Добавить("_$Data$_." + Имя);
		КонецЦикла;
		Отборы.Добавить(Новый Структура("ДатаНачала,ДатаОкончания,Событие,Метаданные", Начало, Конец, СобытияДанных, Справочник));
	КонецЕсли;

	Для Каждого Отбор Из Отборы Цикл
		Таблица = Новый ТаблицаЗначений;
		Попытка
			ВыгрузитьЖурналРегистрации(Таблица, Отбор);
		Исключение
			// Нет прав на журнал регистрации или он недоступен — журнал изменений будет без авторов.
			Продолжить;
		КонецПопытки;
		Для Каждого СтрокаЖурнала Из Таблица Цикл
			Результат.Добавить(Новый Структура("date,user,event,eventPresentation,data,comment,computer",
				Формат(СтрокаЖурнала.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'"),
				СтрокаЖурнала.ИмяПользователя,
				СтрокаЖурнала.Событие,
				СтрокаЖурнала.ПредставлениеСобытия,
				Строка(СтрокаЖурнала.ПредставлениеДанных),
				СтрокаЖурнала.Комментарий,
				СтрокаЖурнала.Компьютер));
		КонецЦикла;
	КонецЦикла;

	МенеджерЗаписи = РегистрыСведений.ИИ_Настройки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Имя = ИмяНастройки;
	МенеджерЗаписи.Значение = XMLСтрока(Конец);
	МенеджерЗаписи.Записать();

	Возврат Результат;

КонецФункции

// Записи журнала изменений из ответа моста: date, section, authors, objects, events, diff.
Процедура ЗаписатьИзменения(Изменения)

	Если ТипЗнч(Изменения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Запись Из Изменения Цикл
		МенеджерЗаписи = РегистрыСведений.ИИ_ИсторияИзменений.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Строка(Новый УникальныйИдентификатор);
		Попытка
			МенеджерЗаписи.Дата = XMLЗначение(Тип("Дата"), Запись.date);
		Исключение
			МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
		КонецПопытки;
		МенеджерЗаписи.Раздел = ЗначениеСвойства(Запись, "section");
		МенеджерЗаписи.Авторы = ЗначениеСвойства(Запись, "authors");
		МенеджерЗаписи.Объекты = ЗначениеСвойства(Запись, "objects");
		МенеджерЗаписи.События = ЗначениеСвойства(Запись, "events");
		МенеджерЗаписи.Изменения = ЗначениеСвойства(Запись, "diff");
		МенеджерЗаписи.Отчет = ЗначениеСвойства(Запись, "html");
		МенеджерЗаписи.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеСвойства(Структура, Имя)

	Значение = "";
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Структура.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

