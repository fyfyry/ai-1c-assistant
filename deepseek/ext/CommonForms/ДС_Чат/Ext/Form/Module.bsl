
&НаКлиенте
Перем ОжидаемОбновление; // Истина, пока мост не подтвердил обновление выгрузки конфигурации.

&НаКлиенте
Перем МоментОткрытия;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИдентификаторОбновления = Параметры.ИдентификаторОбновления;
	// Открываемся на последнем чате, чтобы продолжить разговор; новый — кнопкой «Новый чат».
	СписокЧатов = ДС_ЧатСервер.ЧатыПользователя();
	Если СписокЧатов.Количество() > 0 Тогда
		ТекущийЧат = СписокЧатов[0].Идентификатор;
	КонецЕсли;
	ЗаполнитьЧаты();
	История = ДС_ЧатСервер.ИсторияHTML(ТекущийЧат);

	Проблема = ДС_ЧатСервер.ПроблемаЗапуска();
	Если ЗначениеЗаполнено(Проблема) Тогда
		Состояние = Проблема;
		Элементы.ГруппаВвод.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не Элементы.ГруппаВвод.Доступность Тогда
		// Обмен с мостом невозможен, причина уже показана в строке состояния.
		ОжидаемОбновление = Ложь;
		Возврат;
	КонецЕсли;

	ОжидаемОбновление = ЗначениеЗаполнено(ИдентификаторОбновления);
	МоментОткрытия = ТекущаяДата();
	ОбновитьСостояние(Неопределено);
	ПодключитьОбработчикОжидания("ПроверитьОтветы", 2);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьОтветы");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Ссылки в переписке формирует ДС_ЧатСервер.ИсторияHTML: #reply:<ид> и #delete:<ид>.
// Остальные ссылки (переход к цитате #m<ид>) обрабатывает сам документ.
&НаКлиенте
Процедура ИсторияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = ДанныеСобытия.Anchor;
	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Адрес = Строка(Ссылка.href);

	Позиция = СтрНайти(Адрес, "#reply:");
	Если Позиция > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ОтветитьНаСообщение(Сред(Адрес, Позиция + СтрДлина("#reply:")));
		Возврат;
	КонецЕсли;

	Позиция = СтрНайти(Адрес, "#delete:");
	Если Позиция > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Идентификатор = Сред(Адрес, Позиция + СтрДлина("#delete:"));
		ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьСообщениеЗавершение", ЭтотОбъект, Идентификатор),
			НСтр("ru = 'Удалить сообщение? ИИ-помощник тоже забудет его.'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

// Открытый чат показываем с последних сообщений. Скрипт в самом HTML срабатывает не во всех
// версиях платформы, поэтому прокручиваем ещё и отсюда, когда документ готов.
&НаКлиенте
Процедура ИсторияДокументСформирован(Элемент)

	Попытка
		Конец = Элемент.Документ.getElementById("end");
		Если Конец <> Неопределено Тогда
			Конец.scrollIntoView(Ложь);
		КонецЕсли;
	Исключение
		// Прокрутка — только удобство, без неё чат тоже работает.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЧаты

&НаКлиенте
Процедура ЧатыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОткрытьВыбранныйЧат", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ОжидаемОбновление Или ПустаяСтрока(Сообщение) Тогда
		Возврат;
	КонецЕсли;

	ОтправитьНаСервере();
	Состояние = НСтр("ru = 'ИИ-помощник печатает ответ...'");

КонецПроцедуры

&НаКлиенте
Процедура НовыйЧат(Команда)

	ОтменитьОтвет(Неопределено);
	ОткрытьЧатНаСервере("");
	ТекущийЭлемент = Элементы.Сообщение;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЧат(Команда)

	Данные = Элементы.Чаты.ТекущиеДанные;
	Если Данные = Неопределено Или Не ЗначениеЗаполнено(Данные.Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьЧатЗавершение", ЭтотОбъект, Данные.Идентификатор),
		СтрШаблон(НСтр("ru = 'Удалить чат «%1» со всей перепиской?'"), Данные.Представление),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПравилаБазы(Команда)

	ОткрытьФорму("ОбщаяФорма.ДС_ПравилаБазы", , ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СправкаПомощника(Команда)

	ОткрытьФорму("ОбщаяФорма.ДС_Справка", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзменений(Команда)

	ОткрытьФорму("ОбщаяФорма.ДС_ИсторияИзменений", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиХранилища(Команда)

	ОткрытьФорму("ОбщаяФорма.ДС_НастройкиХранилища", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("НастройкиХранилищаЗавершение", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтвет(Команда)

	ОтветНа = "";
	ОтветНаПредставление = "";
	Элементы.ГруппаОтвет.Видимость = Ложь;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хранилище изменили — сразу просим мост применить настройку и подгрузить историю.
&НаКлиенте
Процедура НастройкиХранилищаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторОбновления = ДС_ЧатСервер.ЗапроситьОбновление();
	ОжидаемОбновление = ЗначениеЗаполнено(ИдентификаторОбновления);
	МоментОткрытия = ТекущаяДата();
	ОбновитьСостояние(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыбранныйЧат() Экспорт

	Данные = Элементы.Чаты.ТекущиеДанные;
	Если Данные = Неопределено Или Не ЗначениеЗаполнено(Данные.Идентификатор)
		Или Данные.Идентификатор = ТекущийЧат Тогда
		Возврат;
	КонецЕсли;

	ОтменитьОтвет(Неопределено);
	ОткрытьЧатНаСервере(Данные.Идентификатор);

КонецПроцедуры

&НаСервере
Процедура ОткрытьЧатНаСервере(Чат)

	ТекущийЧат = Чат;
	История = ДС_ЧатСервер.ИсторияHTML(ТекущийЧат);
	Если Не ЗначениеЗаполнено(Чат) Тогда
		ЗаполнитьЧаты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтветитьНаСообщение(Идентификатор)

	ОтветНаПредставление = ДС_ЧатСервер.ОписаниеСообщения(Идентификатор);
	Если ПустаяСтрока(ОтветНаПредставление) Тогда
		Возврат;
	КонецЕсли;
	ОтветНа = Идентификатор;
	Элементы.ГруппаОтвет.Видимость = Истина;
	ТекущийЭлемент = Элементы.Сообщение;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСообщениеЗавершение(Ответ, Идентификатор) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если ОтветНа = Идентификатор Тогда
		ОтменитьОтвет(Неопределено);
	КонецЕсли;
	УдалитьСообщениеНаСервере(Идентификатор);

КонецПроцедуры

&НаСервере
Процедура УдалитьСообщениеНаСервере(Идентификатор)

	ДС_ЧатСервер.УдалитьСообщение(Идентификатор);
	История = ДС_ЧатСервер.ИсторияHTML(ТекущийЧат);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЧатЗавершение(Ответ, Чат) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Чат = ТекущийЧат Тогда
		ОтменитьОтвет(Неопределено);
	КонецЕсли;
	УдалитьЧатНаСервере(Чат);

КонецПроцедуры

&НаСервере
Процедура УдалитьЧатНаСервере(Чат)

	ДС_ЧатСервер.УдалитьЧат(Чат);
	Если Чат = ТекущийЧат Тогда
		ТекущийЧат = "";
		История = ДС_ЧатСервер.ИсторияHTML(ТекущийЧат);
	КонецЕсли;
	ЗаполнитьЧаты();

КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере()

	ТекущийЧат = ДС_ЧатСервер.ОтправитьСообщение(ТекущийЧат, Сообщение, ОтветНа);
	Сообщение = "";
	ОтветНа = "";
	ОтветНаПредставление = "";
	Элементы.ГруппаОтвет.Видимость = Ложь;
	История = ДС_ЧатСервер.ИсторияHTML(ТекущийЧат);
	ЗаполнитьЧаты();

КонецПроцедуры

// Список чатов слева: группы по дням последнего сообщения, внутри — чаты, недавние сверху.
&НаСервере
Процедура ЗаполнитьЧаты()

	Дерево = РеквизитФормыВЗначение("Чаты");
	Дерево.Строки.Очистить();

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ДеньГруппы = Неопределено;
	Группа = Неопределено;
	Для Каждого Чат Из ДС_ЧатСервер.ЧатыПользователя() Цикл
		День = НачалоДня(Чат.Изменен);
		Если Группа = Неопределено Или День <> ДеньГруппы Тогда
			Группа = Дерево.Строки.Добавить();
			Группа.Представление = ПредставлениеДня(День, Сегодня);
			ДеньГруппы = День;
		КонецЕсли;
		СтрокаЧата = Группа.Строки.Добавить();
		СтрокаЧата.Идентификатор = Чат.Идентификатор;
		СтрокаЧата.Представление = Чат.Наименование + ?(Чат.ОжидаетОтвета, " …", "");
	КонецЦикла;

	ЗначениеВРеквизитФормы(Дерево, "Чаты");

	// Выделяем открытый чат, чтобы повторный выбор другого чата сработал.
	Для Каждого Группа Из Чаты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаЧата Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаЧата.Идентификатор = ТекущийЧат И ЗначениеЗаполнено(ТекущийЧат) Тогда
				Элементы.Чаты.ТекущаяСтрока = СтрокаЧата.ПолучитьИдентификатор();
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПредставлениеДня(День, Сегодня)

	Если День = Сегодня Тогда
		Возврат НСтр("ru = 'Сегодня'");
	ИначеЕсли День = Сегодня - 86400 Тогда
		Возврат НСтр("ru = 'Вчера'");
	КонецЕсли;
	Возврат Формат(День, "ДЛФ=DD");

КонецФункции

&НаСервере
Процедура ОбновитьЧатыНаСервере()

	ЗаполнитьЧаты();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтветы() Экспорт

	Результат = ДС_ЧатСервер.ПроверитьОтветы(ТекущийЧат, ИдентификаторОбновления);

	Если Результат.ЕстьНовые Тогда
		История = Результат.История;
	КонецЕсли;
	Если Результат.ИзменилисьЧаты Тогда
		ОбновитьЧатыНаСервере();
	КонецЕсли;

	Если Результат.ОбновлениеЗавершено Тогда
		ОжидаемОбновление = Ложь;
		ИдентификаторОбновления = "";
	ИначеЕсли ОжидаемОбновление И Не Результат.МостАктивен
		И ТекущаяДата() - МоментОткрытия > 6 Тогда
		// Мост не запущен: обновления не дождёмся, разрешаем писать в чат.
		ОжидаемОбновление = Ложь;
	КонецЕсли;

	ОбновитьСостояние(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояние(Результат)

	// Свойства поля меняем только при смене режима: любое их изменение
	// перерисовывает поле и сбрасывает текст, который пользователь сейчас набирает.
	Если Элементы.Сообщение.ТолькоПросмотр <> ОжидаемОбновление Тогда
		Элементы.Сообщение.ТолькоПросмотр = ОжидаемОбновление;
		Элементы.ФормаОтправить.Доступность = Не ОжидаемОбновление;
	КонецЕсли;

	Если ОжидаемОбновление Тогда
		Состояние = НСтр("ru = 'Обновляю выгрузку конфигурации, подождите...'");
	ИначеЕсли Результат = Неопределено Тогда
		Состояние = "";
	ИначеЕсли Не Результат.МостАктивен Тогда
		Состояние = НСтр("ru = 'Мост не запущен: запустите ai-bridge.cmd в папке ИИ-помощника. Сообщения дождутся его запуска.'");
	ИначеЕсли Результат.ОжидаетсяОтвет Тогда
		Состояние = НСтр("ru = 'ИИ-помощник печатает ответ...'");
	ИначеЕсли ЗначениеЗаполнено(Результат.ТекстОбновления) Тогда
		Состояние = Результат.ТекстОбновления;
	ИначеЕсли СтрНайти(Состояние, "печатает") > 0 Или СтрНайти(Состояние, "Мост") > 0 Тогда
		Состояние = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
