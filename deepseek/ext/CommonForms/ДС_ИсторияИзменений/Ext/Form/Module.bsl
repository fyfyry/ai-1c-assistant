
&НаКлиенте
Перем НачалоПроверки; // когда запросили у моста проверку изменений

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗаписи();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьЗавершение");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаписи

&НаКлиенте
Процедура ЗаписиПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Просим мост сейчас же сравнить базу с прошлой проверкой: изменения попадут в историю,
// не дожидаясь следующего открытия ИИ-помощника.
&НаКлиенте
Процедура Обновить(Команда)

	Если ЗначениеЗаполнено(ИдентификаторОбновления) Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторОбновления = ДС_ЧатСервер.ЗапроситьОбновление();
	Если Не ЗначениеЗаполнено(ИдентификаторОбновления) Тогда
		Состояние = ДС_ЧатСервер.ПроблемаЗапуска();
		Возврат;
	КонецЕсли;
	НачалоПроверки = ТекущаяДата();
	Состояние = НСтр("ru = 'Проверяю изменения в конфигурации, расширениях и обработках…'");
	ПодключитьОбработчикОжидания("ПроверитьЗавершение", 2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьЗавершение() Экспорт

	Результат = ДС_ЧатСервер.СостояниеОбновления(ИдентификаторОбновления);
	Если Результат.Завершено Тогда
		ОтключитьОбработчикОжидания("ПроверитьЗавершение");
		ИдентификаторОбновления = "";
		ЗаполнитьЗаписи();
		Состояние = Результат.Текст;
	ИначеЕсли Не Результат.МостАктивен И ТекущаяДата() - НачалоПроверки > 10 Тогда
		ОтключитьОбработчикОжидания("ПроверитьЗавершение");
		ИдентификаторОбновления = "";
		Состояние = НСтр("ru = 'Мост не запущен: запустите ai-bridge.cmd в папке ИИ-помощника DeepSeek и нажмите «Проверить изменения» еще раз.'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности() Экспорт

	Данные = Элементы.Записи.ТекущиеДанные;
	Если Данные = Неопределено Или Данные.Идентификатор = ТекущаяЗапись Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПодробностиНаСервере(Данные.Идентификатор);

КонецПроцедуры

&НаСервере
Процедура ПоказатьПодробностиНаСервере(Идентификатор)

	ТекущаяЗапись = Идентификатор;
	Подробности = ДС_ЧатСервер.ИзмененияHTML(Идентификатор);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаписи()

	Записи.Загрузить(ДС_ЧатСервер.ИсторияИзменений());
	ТекущаяЗапись = "";
	Если Записи.Количество() > 0 Тогда
		Подробности = ДС_ЧатСервер.ИзмененияHTML(Записи[0].Идентификатор);
		ТекущаяЗапись = Записи[0].Идентификатор;
	Иначе
		Подробности = ДС_ЧатСервер.ИзмененияHTML("");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
