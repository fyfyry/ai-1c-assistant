
&НаКлиенте
Перем ЗакрытиеПодтверждено; // Истина — пользователь уже ответил на вопрос о сохранении.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого Правило Из ДС_ЧатСервер.ПравилаБазы() Цикл
		ЗаполнитьЗначенияСвойств(Правила.Добавить(), Правило);
	КонецЦикла;

КонецПроцедуры

// Закрытие крестиком не должно молча терять изменённые правила.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не Модифицированность Или ЗакрытиеПодтверждено = Истина Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Изменения правил базы не сохранены.'");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Сохранить изменения правил?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравила

&НаКлиенте
Процедура ПравилаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.Используется = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПравилаПриИзменении(Элемент)

	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьНаСервере();
	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНаСервере();
	КонецЕсли;
	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	Список = Новый Массив;
	Для Каждого Правило Из Правила Цикл
		Список.Добавить(Новый Структура("Используется,Текст", Правило.Используется, Правило.Текст));
	КонецЦикла;
	ДС_ЧатСервер.ЗаписатьПравилаБазы(Список);
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти